#!/usr/bin/env bash
# Launcher for loq_kbd.py. Keeps the command short and finds Python wherever it
# lives, including when invoked through a symlink on PATH.
set -uo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
for PY in python3 python; do
    if command -v "$PY" >/dev/null 2>&1; then
        exec "$PY" "$HERE/loq_kbd.py" "$@"
    fi
done
echo "loq-kbd: no python3 on PATH" >&2
exit 1
